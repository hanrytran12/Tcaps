# Copy this file to .env locally and replace every placeholder securely.
# Never commit .env or paste real values into source control.

SA_PASSWORD=replace-with-sql-server-password
ACCEPT_EULA=Y

TCAPS_DB_CONNECTION=Server=localhost;Database=Tcaps;User Id=sa;Password=replace-with-sql-server-password;TrustServerCertificate=True;
TCAPS_SEED_PASSWORD=replace-with-initial-seed-password

JWT_KEY=replace-with-a-long-random-jwt-key
ISSUER=replace-with-jwt-issuer
AUDIENCE=replace-with-jwt-audience

REDIS_PASSWORD=replace-with-redis-password

BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_NAME=replace-with-sender-name
BREVO_SENDER_EMAIL=replace-with-sender-email

BLOB_STORAGE_SETTINGS=replace-with-azure-blob-connection-string
